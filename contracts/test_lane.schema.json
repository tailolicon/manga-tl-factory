{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StandaloneChapterTestLane",
  "type": "object",
  "required": [
    "schema",
    "lane_id",
    "mode",
    "project_id",
    "chapter",
    "source_handoff",
    "state",
    "generation",
    "next_task"
  ],
  "properties": {
    "schema": {"const": 1},
    "lane_id": {"type": "string", "minLength": 1},
    "mode": {"const": "standalone_chapter_test"},
    "project_id": {"type": "string", "minLength": 1},
    "series_key": {"type": ["string", "null"]},
    "chapter": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "source_handoff": {
      "type": "object",
      "required": ["path", "blob_sha"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "blob_sha": {"type": "string", "minLength": 7}
      }
    },
    "acquisition_evidence": {"type": "object"},
    "relay": {"type": ["object", "null"]},
    "workflow": {
      "type": "object",
      "properties": {
        "predeclared": {"type": "boolean"},
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ordinal", "task_type", "status"],
            "properties": {
              "ordinal": {"type": "integer", "minimum": 1},
              "task_type": {"type": "string", "minLength": 1},
              "status": {"enum": ["pending", "ready", "claimed", "completed", "partial", "blocked", "superseded"]},
              "generation": {"type": "integer", "minimum": 1},
              "goal": {"type": "string"},
              "result_task_id": {"type": "string"},
              "scope": {"type": "object"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "state": {
      "enum": ["ready", "claimed", "partial", "completed", "blocked"]
    },
    "generation": {"type": "integer", "minimum": 1},
    "next_task": {
      "type": ["object", "null"],
      "properties": {
        "task_type": {"type": "string"},
        "goal": {"type": "string"},
        "scope": {"type": "object"}
      }
    },
    "claim": {"type": ["object", "null"]},
    "terminal_reason": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string"},
        "detail": {"type": "string"}
      }
    },
    "pipeline_handoff": {
      "type": ["object", "null"],
      "properties": {
        "test_lane_complete": {"type": "boolean"},
        "pipeline_complete": {"type": "boolean"},
        "completed_test_stage": {"type": "string"},
        "production_equivalent": {"type": ["string", "null"]},
        "next_production_stage": {"type": ["string", "null"]},
        "remaining_production_stages": {
          "type": "array",
          "items": {"type": "string"}
        },
        "coordinator_required": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    },
    "last_result": {"type": ["object", "null"]}
  }
}
