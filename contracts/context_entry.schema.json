{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextEntry",
  "type": "object",
  "required": ["id", "kind", "version", "status", "data", "confidence", "evidence"],
  "properties": {
    "id": {"type": "string"},
    "kind": {"enum": ["character", "speech", "term", "relationship", "timeline", "style", "chapter_summary"]},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["candidate", "canonical", "deprecated"]},
    "data": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}
