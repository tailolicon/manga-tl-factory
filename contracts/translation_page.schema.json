{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranslationPage",
  "type": "object",
  "required": ["project_id", "chapter_id", "page_index", "context_version", "blocks"],
  "properties": {
    "project_id": {"type": "string"},
    "chapter_id": {"type": "string"},
    "page_index": {"type": "integer", "minimum": 1},
    "context_version": {"type": "string"},
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block_id", "source_text", "translation", "translation_confidence"],
        "properties": {
          "block_id": {"type": "string"},
          "speaker_id": {"type": ["string", "null"]},
          "source_text": {"type": "string"},
          "translation": {"type": "string"},
          "speaker_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "translation_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
