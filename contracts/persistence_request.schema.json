{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/persistence_request.schema.json",
  "title": "Range binary persistence request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "target_branch", "expected_head", "files"],
  "properties": {
    "schema": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "target_branch": {"type": "string", "pattern": "^chapter/[A-Za-z0-9._/-]+$"},
    "expected_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "receipt_path": {"type": "string", "pattern": "^work/persistence_receipts/[A-Za-z0-9._/-]+\\.json$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "repository_path", "sha256", "width", "height", "size_bytes", "chunks"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "repository_path": {"type": "string", "pattern": "^projects/.+\\.(webp|jpg|jpeg|png)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
          "chunks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "oneOf": [
                {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["blob_sha"],
                  "properties": {"blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
                }
              ]
            }
          }
        }
      }
    }
  }
}
